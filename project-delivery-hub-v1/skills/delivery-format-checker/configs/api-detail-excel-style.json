  "apiDetailSheet": {
    "rebuildPolicy": {
      "mode": "extractTextThenRecreateSheet",
      "preferredForFullSheetFormatClosure": true,
      "script": "scripts/rebuild_api_xlsx_detail_sheets_from_text.ps1",
      "reason": "In-place API Detail sheet repair can leave stale merges, invisible borders, old row heights, polluted H:AZ styles, or mixed section fills. Full-sheet format closure should extract semantic text first, rebuild the worksheet from configured regions, then recheck and render.",
      "sourceExtraction": {
        "visibleTextRange": "A:G",
        "preserveSheetName": true,
        "preserveSheetPosition": true,
        "preserveApiNameDescription": "A2:B2",
        "preserveReturnLink": "recreate C1 -> #'Api_List'!A1",
        "sectionDetection": [
          "optional Header",
          "Request",
          "Response",
          "範例",
          "For中台開發人員",
          "API 內部業務邏輯"
        ],
        "preserveRequestResponseRows": "extract A:G values between section header and next section",
        "preserveExampleRows": "extract A, B:C and D:F text; merge back as B:C / D:F",
        "preserveInternalLogicRows": "extract A and B:F text until first blank logic row; merge back as B:F",
        "preserveTailRows": "extract non-standard visible A:G rows after the standard sections as tail rows, but do not invent business content",
        "preserveWorkbookMediaAndEmbeddings": "Excel COM save only"
      },
      "rebuildSteps": [
        "read each target API worksheet A:G visible text and section boundaries",
        "validate the sheet is safe to rebuild before deleting it",
        "delete the old API worksheet",
        "create a new worksheet with the same name at the same position",
        "write API Name / API Description and recreate C1 返回API_List",
        "write configured sections in order and refill extracted text rows",
        "merge configured ranges such as A:G, A:F, B:C, D:F and B:F",
        "apply region styles from regions and global column widths",
        "clear H:AZ and rows below the rebuilt semantic content",
        "AutoFit non-template content rows with merged-cell measurement",
        "run the final font-slot pass and format recheck"
      ],
      "safeToRebuildWhen": [
        "target API worksheet has no formulas in A:G",
        "target API worksheet has no comments, shapes, pictures, controls, OLE icons or embedded objects that must remain on the sheet",
        "all business text to preserve is visible in A:G",
        "unknown tail rows can be preserved as plain visible A:G text without losing required layout semantics"
      ],
      "doNotRebuildWhen": [
        "sheet contains formulas that must be preserved",
        "sheet contains comments, shapes, pictures, controls, OLE icons or embedded objects",
        "sheet has external hyperlinks or non-text content in the semantic area",
        "important content exists outside A:G and the user has not explicitly approved a custom extraction range",
        "the section order cannot be identified safely"
      ],
      "fallback": "If doNotRebuildWhen is triggered, report Visual risk and use the narrow Excel COM repair scripts only after user confirmation."
    }
  },
