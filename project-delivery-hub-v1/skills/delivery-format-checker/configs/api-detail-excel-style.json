        "dataStartRow": 2,
        "readCompleteVisibleTextBeforeDelete": true,
        "preserveValues": true,
        "preserveApiNameHyperlinks": true,
        "preserveHyperlinkSubAddress": true,
        "preserveSheetPosition": true,
        "preserveWorkbookMediaAndEmbeddings": "Excel COM save only"
      },
      "rebuildSteps": [
        "read Api_List A:J visible text and E column internal hyperlink targets",
        "sync I 後端來源 from matching API sheets when available",
        "validate extracted rows before deleting the old sheet",
        "delete old Api_List sheet",
        "create a new Api_List sheet at the original position",
        "fill configured A:J headers and extracted data rows",
        "sort rows by PRD編號 numeric segments",
        "restore E column internal hyperlinks",
        "apply apiList column widths, fonts, fills, borders, alignment and wrapping",
        "AutoFit all data rows and keep minimum row height",
        "reapply AutoFilter A1:J{lastDataRow}",
        "save with Excel COM and run format recheck"
      ],
      "safeToRebuildWhen": [
        "Api_List has no merged cells",
        "Api_List has no formulas in A:J",
        "Api_List API name hyperlinks are internal sheet jumps or can be reconstructed from matching API sheets",
        "no comments, shapes or embedded objects on Api_List need to be preserved"
      ],
      "doNotRebuildWhen": [
        "A:J contains formulas that must be preserved",
        "Api_List contains comments, shapes, pictures, controls or external hyperlinks that cannot be safely reattached",
        "extracted API rows cannot be matched back to API sheet targets and the user has not approved reconstruction"
      ],
      "fallback": "If doNotRebuildWhen is triggered, report Visual risk and use the narrow in-place repair script only after user confirmation."
    },
