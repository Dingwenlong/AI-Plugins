  "backendApis": {
    "CommonUtil": [
      "IsInTradeDate() 判斷當前時間是否為正常交易時間",
      "GetCENCurr() 取得幣別選單"
    ],
    "Deposit": [
      "GetFixOther() 取得定存轉入帳號與定存幣別"
    ]
  },
  "businessLogic": {
    "steps": [
      {
        "step": 1,
        "title": "初始化與參數處理",
        "details": "移除暫存 redis key，讀取 custId 與 foreignStop。"
      },
      {
        "step": 2,
        "title": "交易時間與交易資格核驗",
        "details": "調用 CommonUtil.IsInTradeDate() 與 foreignStop 做前置校驗。"
      },
      {
        "step": 3,
        "title": "取得選單資料",
        "details": "調用 Deposit.GetFixOther() 取得 subCurrency 與 activityPage。"
      }
    ],
    "fieldMappings": [
      {
        "target": "responseData.subCurrency",
        "source": "Deposit.GetFixOther().subCurrency",
        "rule": "定存幣別列表",
        "fields": [
          {
            "field": "currCName",
            "source": "Deposit.GetFixOther().subCurrency.currCName",
            "rule": "幣別中文"
          },
          {
            "field": "currEName",
            "source": "Deposit.GetFixOther().subCurrency.currEName",
            "rule": "幣別英文"
          }
        ]
      },
      {
        "target": "responseData.activityPage",
        "source": "CommonUtil.LoadForeignSpecode().activityURL",
        "rule": "同意書",
        "fields": [
          {
            "field": "activityPage",
            "source": "CommonUtil.LoadForeignSpecode().activityURL",
            "rule": "同意書網址"
          }
        ]
      }
    ],
    "errorCodeRules": [
      {
        "code": "9016",
        "scenario": "颱風天氣",
        "message": "匯市休市，暫停個人網銀部分交易。"
      },
      {
        "code": "0202",
        "scenario": "ForeignStop=Y",
        "message": "近期有多筆小額結匯交易，暫停外匯交易。"
      }
    ],
    "runtimeDependencies": [
