{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "skillName",
    "manifestType",
    "updatedAt",
    "executionId",
    "apiId",
    "executedStatementCount",
    "seededTables"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "skillName": { "type": "string" },
    "manifestType": { "const": "seed-manifest" },
    "updatedAt": { "type": "string" },
    "executionId": { "type": "string" },
    "apiId": { "type": "string" },
    "executedStatementCount": { "type": "integer", "minimum": 0 },
    "seededTables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tableRef", "resolvedTableName", "rowCount"],
        "properties": {
          "tableRef": { "type": "string" },
          "resolvedTableName": { "type": ["string", "null"] },
          "rowCount": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
