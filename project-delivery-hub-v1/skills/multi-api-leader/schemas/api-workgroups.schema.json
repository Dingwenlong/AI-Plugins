{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi API Workgroups",
  "type": "object",
  "required": ["schemaVersion", "functionCode", "workGroups"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "functionCode": { "type": "string" },
    "generatedAt": { "type": "string" },
    "workGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workGroupId", "apiIds", "claimFiles", "executionMode"],
        "properties": {
          "workGroupId": { "type": "string" },
          "apiIds": { "type": "array", "items": { "type": "string" } },
          "claimFiles": { "type": "array", "items": { "type": "string" } },
          "sharedFiles": { "type": "array", "items": { "type": "string" } },
          "executionMode": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
