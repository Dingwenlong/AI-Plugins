{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/api-spec-writer/project-hard-constraints.schema.json",
  "title": "api-spec-writer project hard constraints",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "projectId",
    "sourceDoc",
    "frameworkProfile",
    "language",
    "appliesToSkills",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "sourceDoc": {
      "type": "string",
      "minLength": 1
    },
    "frameworkProfile": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "appliesToSkills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewNotesTemplate": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "ruleId",
          "scope",
          "fileRole",
          "ruleType",
          "instruction",
          "severity",
          "blocking",
          "appliesTo",
          "examples"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "global_skill",
              "api_behavior",
              "controller",
              "service",
              "entity",
              "test",
              "reporting"
            ]
          },
          "fileRole": {
            "type": "string",
            "enum": [
              "controller",
              "service",
              "entity",
              "unit_test",
              "integration_test",
              "shared"
            ]
          },
          "ruleType": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "functionCodes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "apiCategories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "apiNames": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "businessKeywordsAny": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "unresolved": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "reason",
              "blocking"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              },
              "blockedReason": {
                "type": "string",
                "minLength": 1
              },
              "missingFacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "suggestedOwner": {
                "type": "string",
                "minLength": 1
              },
              "nextDecisionNeeded": {
                "type": "string",
                "minLength": 1
              },
              "triggerKeywordsAny": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "satisfiedByKeywordsAny": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
