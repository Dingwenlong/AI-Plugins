{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Change Plan",
  "description": "Design-stage orchestration plan written by the Design Leader (api-detail-tsd-sync / design-feedback-fix-coordinator) to .agent/functions/<functionCode>/orchestration/design-change-plan.json. See references/design-leader-protocol.md.",
  "type": "object",
  "required": ["schemaVersion", "functionCode", "status", "issues"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "functionCode": { "type": "string" },
    "owner": { "type": "string" },
    "createdAt": { "type": "string" },
    "completedAt": { "type": "string" },
    "status": { "type": "string" },
    "summary": { "type": "string" },
    "workspaceKey": { "type": "string" },
    "projectRoot": { "type": "string" },
    "sourceFiles": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "array", "items": { "type": "string" } },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string" },
          "decision": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
