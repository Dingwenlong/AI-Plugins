{
  "schemaVersion": "1.0.0",
  "standardId": "project-delivery-hub-artifact-naming",
  "updatedAt": "2026-05-27",
  "mode": "standard-only",
  "summary": "Artifact naming standard for project-delivery-hub-v1. This file records proposed names only; it does not authorize automatic migration by itself.",
  "rules": {
    "machineArtifacts": "Use lowercase kebab-case for machine-consumed artifacts.",
    "stageArtifacts": "Use 01-, 02-, 03-, 04-, and 05- prefixes for artifacts owned by a delivery-chain stage.",
    "designHandoff": "Use 00- for design analysis and design-to-development handoff artifacts produced before stage 01.",
    "sharedChainArtifacts": "Use chain- for files maintained by multiple skills or by orchestration.",
    "functionCode": "Preserve dotted function codes such as D.003 and N.001.001.",
    "copiedInputs": "Keep original source filenames under .agent/functions/<functionCode>/inputs/.",
    "customerDeliverables": "Keep external customer delivery names when a project delivery rule already defines them.",
    "currentRound": "Do not rename existing .agent files in this round. Report old names only."
  },
  "actions": {
    "rename_later": "Use the proposed name in the next migration round after script and reader compatibility is implemented.",
    "keep": "Keep the current name because it already matches the shared standard or is intentionally stable.",
    "external_keep": "Keep the current name because the customer or project delivery standard owns it."
  },
