sequenceDiagram
  autonumber

  actor U as "使用者"
  participant C as "Codex"
  participant W as "workspace config"
  participant R as "rule pack resolver"
  participant PR as ".agent/project-rules/<workspaceKey>"
  participant B as "central .agent"
  participant RA as "专案规则分析器"
  participant S as "需求接口设计梳理"
  participant I01 as "01 参考资料索引导入器"
  participant I02 as "02 API 规格写入器"
  participant I03 as "03 SQL 测试资料准备器"
  participant I04 as "04 API 业务代码写入器"
  participant I05 as "05 API 测试与 UT 报告"
  participant V as "原生 VSDX 时序图生成器"
  participant F as "交付格式检查器"
  participant P as "交付包收集器"
  participant PK as "插件打包技能"

  rect rgb(238, 246, 255)
    U->>C: "触发专案交付任务"
    C->>W: "解析 workspaceKey / workspaceRoot / agentRoot / rulesRoot"
    W-->>C: "NEWDAWHO -> D:/Devs/<PROJECT>/.agent"
    C->>B: "读取或建立 config / status / functions / context"
  end

  rect rgb(245, 245, 245)
    alt "规则文件需要外置或更新"
      U->>RA: "输入 Word / Excel / Markdown / JSON 规则文件"
      RA->>PR: "生成 draft 规则 JSON + Markdown"
      RA->>PR: "更新 catalog.json"
      opt "人工确认或 --approve"
        RA->>PR: "reviewStatus = approved / active"
      end
    end
  end

  rect rgb(255, 250, 235)
    loop "每个高风险技能启动前"
      C->>R: "resolve_project_rule_pack.py --pack <rulePack>"
      R->>W: "按参数 / 环境变量 / local-workspaces.json 解析 rulesRoot"
      R->>PR: "读取 catalog.json 的 rulePacks / rules / assets"
      PR-->>R: "返回 required rules + assets"
      R-->>C: "ready 或 blocked"
    end
    alt "规则包 blocked"
      C-->>U: "停止正式产出，报告缺少专案规则"
    else "规则包 ready"
      C-->>U: "进入对应技能流程"
    end
  end

  rect rgb(240, 253, 244)
    alt "已有梳理产物"
      C->>B: "读取 functions/<functionCode>/analysis 和 handoff"
    else "没有梳理产物"
      C->>S: "执行 PRD / TSD / API Detail / Common / Response Code 梳理"
      S->>R: "解析 apiDetailSync 规则包"
      S->>PR: "按需读取 API contract / workbook / field KB / sequence handoff"
      S->>B: "写入 functions/<functionCode>/analysis/*.md"
      S->>B: "复制 inputs/tsd, api-spec, common, response-codes, reference"
      S->>B: "生成 handoff/development-handoff.json"
      S->>B: "更新 status/chain-status.json 的梳理状态"
    end

    opt "已有旧 output 产物"
      C->>B: "迁移 output 中的梳理稿和 sequence files"
      B->>B: "归档到 functions/<functionCode>/analysis/sequence-diagrams"
      B->>B: "写入 status/artifact-migration-*.json"
    end
  end

  rect rgb(250, 245, 255)
    opt "缺少全局外部参考索引"
      C->>I01: "导入外部 API / DB schema / 开发规范"
      I01->>B: "写入 reference/global/catalog.json 和 indexes/*.json"
      I01->>B: "更新 chain-status 的 reference 阶段"
    end

    C->>I02: "启动 02"
    I02->>R: "解析 apiSpecWriter 规则包"
    I02->>B: "优先读取 functions/<functionCode>/handoff/development-handoff.json"
    alt "handoff 存在且 ready"
      I02->>B: "读取 inputs/reference > reference/global > legacy Reference"
      I02->>B: "生成 context/<functionCode>/apis/<apiId>/*_API_Spec.json"
      I02->>B: "写入 codeHandoff / mockExamples / spec 状态"
    else "handoff 缺失或 blocked"
      I02-->>S: "回到梳理逻辑生成开发输入包"
    end
  end

  rect rgb(239, 246, 255)
    opt "API 涉及 SQL / DB"
      C->>I03: "启动 03"
      I03->>R: "解析 sqlFixture 规则包"
      I03->>B: "读取 API_Spec.json 的 queryContracts / unresolved"
      I03->>B: "回写 fixtureStatus / fixtureBlockReason"
    end

    C->>I04: "启动 04 prepare"
    I04->>R: "解析 apiCodeWriter 规则包"
    I04->>B: "读取 spec / manifest / review-notes"
    I04->>B: "生成 change-plan.json 和 testCodeHandoff"
    I04-->>C: "Codex 按计划修改目标代码分支"
    C->>I04: "执行 apply"
    I04->>B: "回写 codeStatus / code-progress.md"
  end

  rect rgb(255, 247, 237)
    opt "需要正式测试代码或 UT 报告"
      C->>I05: "启动 05"
      I05->>R: "解析 unitTestReport 规则包"
      I05->>B: "读取 API_Spec.mockExamples 和 04 test handoff"
      I05->>C: "生成或维护测试源码并执行验证"
      I05->>B: "写入报告 manifest / results / DOCX"
      I05->>B: "回写 testStatus"
    end
  end

  rect rgb(236, 253, 245)
    opt "需要正式时序图"
      C->>V: "启动 VSDX 时序图技能"
      V->>R: "解析 sequenceDiagram 规则包"
      V->>PR: "读取 native template / shape library / PlantUML style"
      V->>B: "输出 analysis/sequence-diagrams 下的 VSDX / SVG / PNG / PUML"
      V->>B: "更新 chain-status 的 diagram 状态"
    end

    opt "需要交付格式闭环"
      C->>F: "启动格式检查器"
      F->>R: "解析 deliveryFormat 规则包"
      F->>PR: "读取 TSD / API Detail 格式规则和 Excel style"
      F->>C: "检查或修复 DOCX / XLSX"
      F->>B: "记录格式检查结果"
    end

    opt "需要客户交付包"
      C->>P: "启动交付包收集器"
      P->>B: "优先读取 functions/<functionCode>/analysis"
      P->>P: "确认可进入开发 / 冻版 / 已确认交付物"
      P->>C: "只复制交付文件，不删除来源"
    end
  end

  rect rgb(241, 245, 249)
    opt "插件规则或技能已更新"
      C->>PK: "执行插件打包技能"
      PK->>PK: "同步 company-jimmy / company-dev marketplace"
      PK->>PK: "同步 Codex cache，排除 .bak / __pycache__"
      PK-->>U: "返回 plugin://project-delivery-hub-v1@company-jimmy 和 @company-dev"
    end
  end
