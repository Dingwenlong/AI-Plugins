flowchart LR
  %% Project Delivery Hub skill-to-.agent relationship map

  classDef skill fill:#eef6ff,stroke:#2563eb,stroke-width:1px,color:#0f172a
  classDef agent fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#052e16
  classDef rule fill:#fff7ed,stroke:#ea580c,stroke-width:1px,color:#431407
  classDef external fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#0f172a
  classDef status fill:#fefce8,stroke:#ca8a04,stroke-width:1px,color:#422006

  subgraph SK["专案交付中枢技能"]
    RA["专案规则分析器"]
    S["专案需求接口设计梳理"]
    I01["01 参考资料索引导入器"]
    I02["02 API 规格写入器"]
    I03["03 SQL 测试资料准备器"]
    I04["04 API 业务代码写入器"]
    I05["05 API 测试与 UT 报告"]
    V["专案原生 VSDX 时序图生成器"]
    F["专案交付文件格式检查器"]
    P["专案交付包收集器"]
    PK["插件打包技能"]
  end

  subgraph AGENT["D:/Devs/<PROJECT>/.agent"]
    CFG["config/chain-workspace.json"]
    DSRC["config/design-source-registry.json"]
    ST["status/chain-status.json"]
    MIG["status/artifact-migration-*.json"]

    subgraph RULES["project-rules/<workspaceKey>"]
      RCAT["catalog.json"]
      RP["rulePacks"]
      RR["rules/<category>/*.md|json"]
      RA2["assets/visio|excel|docx"]
      RS["sources/raw + converted"]
    end

    subgraph FUNC["functions/<functionCode>"]
      AN["analysis/*.md"]
      SD["analysis/sequence-diagrams/*"]
      INP["inputs/tsd|api-spec|common|response-codes|reference"]
      HO["handoff/development-handoff.json"]
    end

    subgraph REF["reference/global"]
      RGC["catalog.json"]
      RGI["indexes/*.json"]
      RGR["raw/external-api|db-schema"]
    end

    subgraph CTX["context/<functionCode>"]
      EX["execution-state.json"]
      CK["api-checklist.json"]
      SP["spec-progress.md"]
      CP["code-progress.md"]
      API["apis/<apiId>"]
      SPEC["*_API_Spec.json"]
      MAN["manifest.json"]
      PLAN["change-plan.json"]
      TEST["test manifest / results / trx / report"]
    end

    DG["diagrams/*.mmd|svg"]
  end

  subgraph EXT["外部或工作区"]
    DOCS["PRD / TSD / API Detail / Common / Response Code"]
    CODE["实际代码分支 project-root"]
    DEL["客户交付目录 TSD 交付 yyyyMMdd"]
    PLUG["company-jimmy / company-dev / Codex cache"]
  end

  RA -->|"分析 Word/Excel/Markdown/JSON"| RS
  RA -->|"写入 draft/approved 规则"| RR
  RA -->|"登记规则与资产"| RCAT
  RA -->|"维护 active 规则包"| RP

  S -->|"读取 apiDetailSync rulePack"| RP
  S -->|"读取专案规则"| RR
  S -->|"复制开发输入"| INP
  S -->|"生成梳理稿"| AN
  S -->|"生成 handoff"| HO
  S -->|"更新梳理状态"| ST
  S -->|"读取设计来源目录"| DSRC
  DOCS -->|"事实来源"| S

  I01 -->|"导入外部参考资料"| RGR
  I01 -->|"建立全局索引"| RGC
  I01 -->|"生成分类索引"| RGI
  I01 -->|"更新 reference 状态"| ST

  I02 -->|"读取 apiSpecWriter rulePack"| RP
  I02 -->|"优先读取 handoff"| HO
  I02 -->|"读取功能 inputs"| INP
  I02 -->|"补充全局 reference"| REF
  I02 -->|"生成 API Spec"| SPEC
  I02 -->|"更新 spec 状态"| EX
  I02 -->|"更新 API checklist"| CK
  I02 -->|"记录 spec-progress"| SP
  I02 -->|"更新总控"| ST

  I03 -->|"读取 sqlFixture rulePack"| RP
  I03 -->|"消费 queryContracts"| SPEC
  I03 -->|"读取 DB schema / defaults"| RGC
  I03 -->|"写入 fixtureStatus"| EX
  I03 -->|"更新总控"| ST

  I04 -->|"读取 apiCodeWriter rulePack / code-guidelines"| RP
  I04 -->|"消费 API Spec / manifest"| API
  I04 -->|"生成 change-plan"| PLAN
  I04 -->|"修改业务代码"| CODE
  I04 -->|"记录 code-progress"| CP
  I04 -->|"交接测试目标"| PLAN
  I04 -->|"更新 code 状态"| ST

  I05 -->|"读取 unitTestReport rulePack"| RP
  I05 -->|"读取 mockExamples"| SPEC
  I05 -->|"读取 test handoff"| PLAN
  I05 -->|"生成测试源码或运行测试"| CODE
  I05 -->|"写入测试证据与报告"| TEST
  I05 -->|"更新 test 状态"| ST

  V -->|"读取 sequenceDiagram rulePack"| RP
  V -->|"读取 VSDX template / shape library"| RA2
  V -->|"输出 VSDX / SVG / PNG / PUML"| SD
  V -->|"更新 diagram 状态"| ST

  F -->|"读取 deliveryFormat rulePack"| RP
  F -->|"读取 Excel style / TSD format rules"| RA2
  F -->|"检查或修复交付文件"| DOCS
  F -->|"记录格式检查结果"| ST

  P -->|"读取已确认交付物"| AN
  P -->|"读取时序图交付物"| SD
  P -->|"只复制，不删除来源"| DEL
  P -->|"记录打包结果"| ST

  PK -->|"读取打包规则"| CFG
  PK -->|"同步插件包"| PLUG

  C1["workspace 解析"] --> CFG
  C1 --> ST
  C1 --> RULES

