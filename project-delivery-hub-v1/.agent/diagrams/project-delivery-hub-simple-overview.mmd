flowchart TB
  %% 简化版：专案交付中枢主流程

  classDef start fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#431407
  classDef gate fill:#fefce8,stroke:#ca8a04,stroke-width:2px,color:#422006
  classDef skill fill:#eef6ff,stroke:#2563eb,stroke-width:1.5px,color:#0f172a
  classDef base fill:#ecfdf5,stroke:#16a34a,stroke-width:1.5px,color:#052e16
  classDef optional fill:#f8fafc,stroke:#64748b,stroke-width:1.2px,color:#0f172a
  classDef result fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#2e1065

  A["使用者提出任务<br/>例：梳理功能、生成 API Spec、写代码、出报告"]:::start
  B["读取 workspace 配置<br/>workspaceKey / agentRoot / rulesRoot"]:::base
  G{"后续正式产出规则包门禁<br/>project-rules/catalog.json"}:::gate

  H{"这个功能<br/>已有梳理产物？"}:::gate
  S["专案需求接口设计梳理<br/>读 PRD / TSD / API Detail / Common / Response Code"]:::skill
  SF["落到 .agent/functions/&lt;功能&gt;<br/>analysis + inputs + handoff"]:::base

  R1["01 参考资料索引<br/>只在缺外部 API / DB Schema 索引时使用"]:::optional
  RG[".agent/reference/global<br/>catalog + indexes + raw files"]:::base

  W2["02 API 规格写入器<br/>从 handoff 生成 API_Spec.json"]:::skill
  C2[".agent/context/&lt;功能&gt;/apis/&lt;API&gt;<br/>API_Spec + codeHandoff + mockExamples"]:::base

  W3["03 SQL 测试资料准备器<br/>仅 DB / SQL API 需要"]:::optional
  W4["04 API 业务代码写入器<br/>prepare -> Codex 改码 -> apply"]:::skill
  CODE["开发分支结束（无 UT 报告）<br/>Controller / Service / Entity"]:::result

  W5["05 API 测试与 UT 报告<br/>生成/维护测试 + DOCX 报告"]:::optional
  REPORT["开发分支结束<br/>manifest / trx / DOCX"]:::result

  V["原生 VSDX 时序图<br/>输出 VSDX / SVG / PUML / PNG"]:::optional
  DGM[".agent/functions/&lt;功能&gt;/analysis/sequence-diagrams"]:::base

  F["交付格式检查器<br/>检查 TSD Word / API Excel"]:::optional
  P["交付包收集器<br/>从 analysis 的已确认交付物复制"]:::optional
  DEL["客户交付目录<br/>TSD 交付 yyyyMMdd"]:::result

  ST[".agent/status/chain-status.json<br/>记录每个功能当前到哪一步"]:::base

  A --> B --> H

  H -- "没有" --> S --> SF
  H -- "有" --> SF

  SF --> G
  G -- "blocked：缺规则" --> STOP["暂停 02/04/交付<br/>先补专案规则"]:::result
  G -- "ready" --> W2
  R1 --> RG
  RG -. "外部参考补充" .-> W2
  W2 --> C2

  C2 -. "有 SQL 依赖" .-> W3
  W3 --> C2
  C2 --> W4 --> CODE
  W4 --> C2

  W4 -. "需要 UT 报告" .-> W5 --> REPORT
  SF -. "需要正式图" .-> V --> DGM
  SF -. "需要格式闭环" .-> F
  SF -. "需要交付包" .-> P --> DEL

  S --> ST
  W2 --> ST
  W3 --> ST
  W4 --> ST
  W5 --> ST
  V --> ST
  F --> ST
  P --> ST
