flowchart LR
  %% 简化版：各技能与 .agent 的关系

  classDef skill fill:#eef6ff,stroke:#2563eb,stroke-width:1.5px,color:#0f172a
  classDef base fill:#ecfdf5,stroke:#16a34a,stroke-width:1.5px,color:#052e16
  classDef rule fill:#fff7ed,stroke:#f97316,stroke-width:1.5px,color:#431407
  classDef result fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.5px,color:#2e1065
  classDef note fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#334155

  subgraph LEFT["技能：做事的人"]
    S["需求接口设计梳理<br/>把设计资料整理成开发输入包"]:::skill
    RA["专案规则分析器<br/>把规则文件变成可读取规则"]:::skill
    I01["01 参考资料索引<br/>导入外部资料索引"]:::skill
    I02["02 API 规格写入器<br/>生成 API_Spec.json"]:::skill
    I03["03 SQL 测试资料准备器<br/>准备 SQL fixture"]:::skill
    I04["04 API 业务代码写入器<br/>生成改码计划并落业务代码"]:::skill
    I05["05 UT 报告生成器<br/>测试代码 + 报告"]:::skill
    V["VSDX 时序图生成器<br/>正式 Visio 图"]:::skill
    F["格式检查器<br/>检查 Word / Excel 格式"]:::skill
    P["交付包收集器<br/>复制已确认交付物"]:::skill
  end

  subgraph MID["集中资料库：D:/Devs/<PROJECT>/.agent"]
    PR["project-rules/&lt;workspaceKey&gt;<br/>专案规则库<br/>catalog + rulePacks + assets"]:::rule
    FN["functions/&lt;functionCode&gt;<br/>按功能收拢设计产物<br/>analysis + inputs + handoff"]:::base
    REF["reference/global<br/>跨功能外部参考<br/>外部 API / DB schema 索引"]:::base
    CTX["context/&lt;functionCode&gt;<br/>开发执行面<br/>API_Spec / manifest / change-plan / test results"]:::base
    ST["status/chain-status.json<br/>总控状态<br/>每个功能当前走到哪一步"]:::base
  end

  subgraph RIGHT["外部结果：真正交付或修改的东西"]
    CODE["实际代码分支<br/>project-root"]:::result
    DOC["设计文件<br/>TSD Word / API Excel"]:::result
    VSDX["时序图交付物<br/>VSDX / SVG / PNG / PUML"]:::result
    REPORT["UT 报告<br/>DOCX / TRX / results"]:::result
    DEL["客户交付包<br/>TSD 交付 yyyyMMdd"]:::result
  end

  NOTE1["一句话理解：<br/>先梳理需求形成 functions/handoff；project-rules 管规则，reference 管外部共用资料，context 管开发执行状态，status 管总控进度。"]:::note

  RA -->|"写规则"| PR

  S -->|"读规则"| PR
  S -->|"写梳理稿 / inputs / handoff"| FN
  S -->|"更新进度"| ST
  DOC -->|"来源资料"| S

  I01 -->|"写全局索引"| REF
  I01 -->|"更新进度"| ST

  I02 -->|"读 handoff"| FN
  I02 -->|"补充外部参考"| REF
  I02 -->|"写 API_Spec + codeHandoff"| CTX
  I02 -->|"更新 spec 状态"| ST

  I03 -->|"读 SQL 规则"| PR
  I03 -->|"读 API_Spec"| CTX
  I03 -->|"写 fixture 状态"| CTX
  I03 -->|"更新进度"| ST

  I04 -->|"读 apiCodeWriter + code-guidelines"| PR
  I04 -->|"读 API_Spec / 写 change-plan"| CTX
  I04 -->|"修改代码"| CODE
  I04 -->|"更新 code 状态"| ST

  I05 -->|"读 UT 模板 / checklist / 映射规则"| PR
  I05 -->|"读 Spec + 测试交接"| CTX
  I05 -->|"生成测试 / 报告"| REPORT
  I05 -->|"写测试结果"| CTX
  I05 -->|"更新 test 状态"| ST

  V -->|"读时序图规则和 VSDX 模板"| PR
  V -->|"把图放回功能目录"| FN
  V -->|"输出正式图"| VSDX
  V -->|"更新 diagram 状态"| ST

  F -->|"读格式规则和 Excel style"| PR
  F -->|"检查或修复"| DOC
  F -->|"记录检查结果"| ST

  P -->|"读已确认交付物"| FN
  P -->|"复制交付包"| DEL
  P -->|"记录打包结果"| ST

  NOTE1 --- MID
