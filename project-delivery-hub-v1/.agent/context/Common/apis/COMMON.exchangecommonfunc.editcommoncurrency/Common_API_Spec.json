  "businessLogic": {
    "steps": [
      {
        "step": 1,
        "title": "初始化參數",
        "details": "1. 從 Redis / 框架上下文取得 @CustId。\n2. 將 currencyCodeArray 轉為 [{\"CURRENAME\":\"USD\"},{\"CURRENAME\":\"JPY\"},{\"CURRENAME\":\"EUR\"}] 物件陣列字串，後續入庫。"
      },
      {
        "step": 2,
        "title": "更新或新增",
        "details": "MERGE INTO CommonCurrencyList AS target\nUSING (SELECT @CustId AS CustId, @CurrencyList AS CurrencyList, GETDATE() AS ModifyDate) AS source\nON target.CustId = source.CustId\n-- 1. 如果設置過幣別順序，根據最新設置的順序進行更新；\nWHEN MATCHED THEN\nUPDATE SET target.CurrencyList = source.CurrencyList,\ntarget.ModifyDate = source.ModifyDate\n-- 2. 如果沒有設置過幣別順序，新增一條設置記錄；\nWHEN NOT MATCHED THEN\nINSERT (CustId, CurrencyList, ModifyDate)\nVALUES (source.CustId, source.CurrencyList, source.ModifyDate);\n3. DB 更新成功後，同步刷新 Redis 常用幣別快取，確保回到首頁或匯率表時優先讀取 Redis。"
      },
      {
        "step": 3,
        "title": "回傳執行結果",
        "details": "3.回傳執行結果"
      }
    ],
