  "businessLogic": {
    "steps": [
      {
        "step": 1,
        "title": "查詢資料庫",
        "details": "1.SeqName=\"FntTranSeq_DAWHO\",NewSeqVal=\"ParameterOutput\"\n執行dbo.usp_GetNewUserID @SeqName,@NewSeqVal\"查詢到新的序列號值newSeqVal;"
      },
      {
        "step": 2,
        "title": "判斷結果",
        "details": "1.如果數據庫查詢失敗，提示錯誤訊息;\n2.進行組合序列號：\nint len = 13 - seq.Length;\nif (len < 0)\n{\n回傳錯誤訊息；\n}\nelse\n{\nseq = seq.PadLeft(13, '0');\nif (TransactionID == \"NTFXJ6200\")\n{\nfntTranSeq = \"MMA--\" + TransactionID + seq;\n}\nelse\n{\nfntTranSeq = \"MMA-\" + TransactionID + \"-\" + seq;\n}\n}"
      },
      {
        "step": 3,
        "title": "回傳結果",
        "details": "如果請求成功，回傳結果"
      }
    ],
