  "businessLogic": {
    "steps": [
      {
        "step": 1,
        "title": "參數與初始化",
        "details": "1.判斷Request.fixAPNo、Request.curr 和Request.period是否為空\n如果不為空，將傳參組合為loaderParam參數進行查詢"
      },
      {
        "step": 2,
        "title": "從DB撈取定存設定檔",
        "details": "SELECT\nDB.StartDate,\nDB.EndDate,\nDB.TermVersion,\nDB.ActivityPage,\nDB.Loader,\nDB.Title,\nDB.IsNewFunds,\nDB.ActivityURL,\nDB.ActivityURL_1,\nDB.ActivityURL_2,\nDB.ActivityURL_3,\nDB.ActivityURL_4\nFROM DB\nWHERE EndDate >= CURDATE()\nAND (\n(:loaderParamIS NOT NULL AND :loaderParam!= '' AND DB.loader = :loaderParam)\nOR\n((:loaderParam IS NULL OR :loaderParam= '') AND :curr IS NOT NULL AND :curr != '' AND DB.loader LIKE CONCAT('%', :curr, '%'))\nOR\n((:loaderParam IS NULL OR :loaderParam= '') AND (:curr IS NULL OR :curr = ''))  -- 两者都为空，不限制loader\n);"
      },
      {
        "step": 5,
        "title": "組合Response進行返回",
        "details": "組合response進行返回"
      }
    ],
