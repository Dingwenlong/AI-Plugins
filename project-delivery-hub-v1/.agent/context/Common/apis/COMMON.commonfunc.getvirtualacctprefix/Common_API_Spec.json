        "step": 1,
        "title": "組合T24帳號格式",
        "details": "1.根據條件進行判斷\nif (isCardNo)\n{\nt24PayeeAcct = \"CRD\" +  payeeAcct;\n}\nelse if ( payeeAcct.Length==14)\n{\nt24PayeeAcct=  payeeAcct;\n}\nelse if ( payeeAcct.StartsWith(\"00\"))\n{\nt24PayeeAcct=  payeeAcct.Substring(2);\n}\nelse if ( payeeAcct.StartsWith(\"287\"))\n{\nt24PayeeAcct= \"AIG\" +  payeeAcct;\n}\nelse if ( payeeAcct.StartsWith(\"7\"))\n{\nt24PayeeAcct= \"B\" +  payeeAcct;\n}\nelse if ( payeeAcct.StartsWith(\"8\"))\n{\nt24PayeeAcct = \"C\" +  payeeAcct;\n}\nelse if ( payeeAcct.StartsWith(\"9\"))\n{\nt24PayeeAcct = \"D\" +  payeeAcct;\n}"
      },
