    ]
  },
  "businessLogic": {
    "steps": [
      {
        "step": 1,
        "title": ": 初始化區塊",
        "details": "1.定義strXmp=\"\";//1.一般客戶 2.行員\n2.從Redis中取得custId、isStaff、isOBUCustomer，如果isStaff=true： strXmp = \"2\";"
      },
      {
        "step": 2,
        "title": "判斷客戶身分",
        "details": "1.如果checkVIP=true：\n調用CommonFunc.CheckVIP,取得客戶身分,將CommonFunc.CheckVIP.vipType 賦值給strXmp;\n2.如果checkVIP=false：strXmp=\"1\""
      },
      {
        "step": 3,
        "title": "扣款和收款幣別相同",
        "details": "1.若扣款/收款幣別相同，直接視為「不需換匯」 => 匯率=1，不敲價"
      },
      {
        "step": 4,
        "title": "若轉出幣別 !== 轉入幣別→用敲價",
        "details": "1. 定義\n客戶轉出帳號：  string strRBrNo = debitCurrency.Substring(0, 3);\n來源代號：  string intSource=8;固定值\n輸入單位代碼(敲價行)(或分行碼)；固定值:769 ：string  strBrNo=769\n是否OBU：  string strBU = isOBUCustomer ? \"O\" : \"D\";\n2.調用fntTranSeq=CommonFunc.GenFntTranSeq()取得交易序號\n2.調用ETSService.RequestSpotDs(intSource, strBrNo, strRBrNo, debitCurrency, payeeCurrency, decDebitAmount, decPayeeAmount, strXmp, strNote, strBU, custId, fntTranSeq);"
      },
      {
        "step": 5,
        "title": "ETS 回覆解析",
        "details": "1.成功: 填寫承作匯率(DoneRate)、牌價(ListRate)、成本匯率(CostRate)、中價匯率(MidlRate)、實際扣款金額(BuyAmount)、收款金額(SellAmount)、等值臺幣/美元(EquvBaseAmount, EquvUsdAmount)等\n2.失敗根據錯誤碼回傳錯誤提示:\nswitch (XMLRetCode)\n{\ncase \"-101\":\nmessage = \"目前無法取得折臺幣金額，請稍後再試。\";\nbreak;\ncase \"-103\":\nmessage = \"金額不符規定！\";\nbreak;\ncase \"-104\":\nmessage = \"金額不符規定！\";\nbreak;\ncase \"-105\":\nmessage = \"金額不符規定！\";\nbreak;\ncase \"-106\":\nmessage = \"金額不符規定！\";\nbreak;\ncase \"-108\":\nmessage = \"金額超過匯率優惠等值參萬美元上限!如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-121\":\nmessage = \"交易失敗[-121]!不提供匯率報價，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-122\":\nmessage = \"交易失敗[-122]!不提供匯率報價，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-123\":\nmessage = \"交易失敗[-123]!不提供匯率報價，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-125\":\nmessage = \"交易失敗[-125]!暫停匯率報價，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-126\":\nmessage = \"交易失敗[-126]!暫停匯率報價，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-127\":\nmessage = \"交易失敗[-127]!暫停匯率報價，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-128\":\nmessage = \"交易失敗[-128]!暫停匯率報價，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-129\":\nmessage = \"交易失敗[-129]!暫停匯率報價，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"-159\":\nmessage = \"金額上限請勿超過等值人民幣2萬元。\";\nbreak;\ncase \"-361\":\ncase \"-362\":\nmessage = \"新臺幣結匯金額單筆/累計上限請勿超過(含)等值美金100萬元，請臨櫃辦理。\";\nbreak;\ncase \"-363\":\ncase \"-364\":\nmessage = \"新臺幣結匯金額單筆/累計上限請勿超過(含)等值美金50萬元，請臨櫃辦理。\";\nbreak;\ncase \"-1\"://20100316 by howard :當敲價系統錯誤時，回傳-1給前端\nmessage = \"系統忙線中請稍後再試(-1)，如有任何問題，請洽本行24小時客服專線(02-2505-9999)\";\nbreak;\ncase \"ERRAMT\":\nmessage = \"金額輸入錯誤，金額下限請勿低於等值新臺幣100元，金額上限請勿超過(含)等值新臺幣50萬元。\";\nbreak;\ncase \"CNYERRAMT\":\nmessage = \"金額輸入錯誤，金額下限請勿低於等值新臺幣100元，金額上限請勿超過等值人民幣2萬元。\";\nbreak;\ncase \"CNYERRAMT_MAX\":\nmessage = \"金額上限請勿超過等值人民幣2萬元。\";\nbreak;\ncase \"ERRAMT_PreForeign_Cash\":\nmessage = \"金額輸入錯誤，金額上限請勿輸入超過(含)等值新臺幣50萬元。\";\nbreak;\ncase \"CNYERRAMT_PreForeign_Cash\":\nmessage = \"金額輸入錯誤，金額上限請勿輸入超過(含)等值人民幣2萬元。\";\nbreak;\ncase \"ERRAMTNEW\":\nmessage = \"金額輸入錯誤，金額下限請勿低於等值新臺幣100元，金額上限請勿超過(含)等值新臺幣200萬元。\";\nbreak;\ncase \"ERRAMTBUSINESS_TIME_NONEICS\":\nmessage = \"無有效憑證提醒！您尚未申請軟體憑證，僅限辦理新臺幣50萬元(不含)以下換匯交易。\";\nbreak;\ncase \"ERRAMTNEW2\":\nmessage = \"金額輸入錯誤，金額下限請勿低於等值新臺幣100元，金額上限請勿超過(含)等值美金50萬元。\";\nbreak;\ncase \"ERRAMT_MIN\":\nmessage = \"金額輸入錯誤，金額下限請勿低於等值新臺幣100元。\";\nbreak;\ncase \"ERROURCURREXFIX\":\nmessage = \"單筆詢價金額不得逾USD499,999。\";\nbreak;\ncase \"NOSINOPACICS\":\nmessage = \"提醒！您尚未安裝元件，僅限新臺幣50萬元(含)以下換匯交易\\n請先準備好自然人憑證與安裝元件\";\nbreak;\ncase \"NOSINOPACICSNEW\":\nmessage = \"提醒！請先準備好自然人憑證安裝元件，以利後續新臺幣50萬元以上換匯交易。\";\nbreak;\ncase \"-161\":\nmessage = \"單筆詢價金額不得逾USD499,999。\";\nbreak;\ndefault:\nmessage = \"目前無法取得折臺幣金額，請稍後再試。\";\nbreak;\n}"
      },
      {
        "step": 6,
        "title": "組合Response回傳",
        "details": "1.將資料存入redis：Ent_Com_RateEnquiry_ETSRequestr\n2.將strXmp存入Ent_Com_VipFlag_Flag"
      }
    ],
