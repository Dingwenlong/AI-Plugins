        "details": "1.執行SQL查詢\nSELECT\nDispName,\nListBuy,\nListSell,\nNoteBuy,\nNoteSell,\nRateTime\nFROM\n[dbo].[ETS_vSPListHist]\nWHERE\nRateTime >= @startDateTime\nAND RateTime <= @endDateTime\nAND DispName = @currEName\nORDER BY\nRateTime DESC;"
