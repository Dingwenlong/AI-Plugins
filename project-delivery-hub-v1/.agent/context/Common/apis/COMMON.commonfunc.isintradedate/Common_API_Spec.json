    "steps": [
      {
        "step": 1,
        "title": "參數與初始化",
        "details": "1.調用CommonFunc.GetOperationHour取得營業日資料\n2.定義isInTradeDate=true;t24BR1210pen=\"N\";"
      },
      {
        "step": 2,
        "title": "判斷邏輯",
        "details": "1.  if (CommonFunc.GetOperationHour().t24MODE == \"B\")\n{\nisInTradeDate=false;\n}\nelse if (CommonFunc.GetOperationHour().t24BR121Open != \"Y\")\n{\nisInTradeDate=false;\nt24BR1210pen=\"Y\";\n}\nelse if (CommonFunc.GetOperationHour().t24TBSDY != DateTime.Now.ToString(\"yyyyMMdd\"))\n{\nisInTradeDate=false;\n}\nelse if (DateTime.Now.Hour < 9)\n{\nisInTradeDate=false;\n}\nelse if (DateTime.Now.Hour >= 23)\n{\nisInTradeDate=false;\n}"
      },
      {
        "step": 3,
        "title": "回傳結果",
        "details": "3.回傳結果"
      }
    ],
