        "details": "1.取得帳號使用邏輯：object[] acctList = CommonUtil.GetAcctKind(transCode, webSource);"
      },
      {
        "step": 3,
        "title": "逐一篩選，帳號限制",
        "details": "// 逐一篩選\nvar accountList = GetEC0001()\n.Where(a =>\n(string.IsNullOrEmpty(acctList[0]) || a.NonTrxferFlg != acctList[0]) &&\n(string.IsNullOrEmpty(acctList[1]) || a.GenQuotaMark == acctList[1]) &&\n(string.IsNullOrEmpty(acctList[2]) || a.GenAcctMark == acctList[2]) &&\n(string.IsNullOrEmpty(acctList[3]) || a.SinopayFlag == acctList[3]) &&\n(acctList.Skip(4).All(x => string.IsNullOrEmpty(x)) || acctList.Skip(4).Contains(a.AccType))\n)\n.ToList();"
      },
